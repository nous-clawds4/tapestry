{
    "word": {
        "slug": "json-schema-for-the-concept-of-dogs",
        "title": "JSON Schema for the Concept of Dogs",
        "name": "JSON Schema for the concept of dogs",
        "description": "Schema for dog nodes, with conditional breed → wordTypes enforcement.",
        "wordTypes": [
            "word",
            "jsonSchema",
            "validationTool"
        ],
        "coreMemberOf": [
            {
                "slug": "concept-header-for-the-concept-of-dogs",
                "uuid": "<uuid>"
            }
        ]
    },
    "jsonSchema": {
        "name": "dog",
        "title": "Dog",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": [
            "word",
            "dog"
        ],
        "properties": {
            "word": {
                "type": "object",
                "properties": {
                    "wordTypes": {
                        "type": "array",
                        "items": { "type": "string" },
                        "minItems": 1
                    }
                }
            },
            "dog": {
                "type": "object",
                "name": "dog",
                "title": "Dog",
                "slug": "dog",
                "description": "Metadata about this dog node",
                "required": [
                    "slug",
                    "name"
                ],
                "properties": {
                    "slug": {
                        "type": "string",
                        "name": "slug",
                        "title": "Slug",
                        "slug": "slug",
                        "description": "Unique identifier for this dog"
                    },
                    "breed": {
                        "type": "string",
                        "name": "dog breed",
                        "title": "Dog Breed",
                        "slug": "dog-breed",
                        "description": "The breed for this dog",
                        "enum": ["goldenRetriever", "irishSetter"]
                    },
                    "name": {
                        "type": "string",
                        "name": "name",
                        "title": "Name",
                        "slug": "name",
                        "description": "The name for this dog"
                    }
                },
                "x-tapestry": {
                    "unique": [
                        "slug"
                    ]
                }
            }
        },
        "allOf": [
            {
                "$comment": "Forward: if breed is goldenRetriever, wordTypes must contain it",
                "if": {
                    "properties": {
                        "dog": {
                            "properties": {
                                "breed": { "const": "goldenRetriever" }
                            },
                            "required": ["breed"]
                        }
                    }
                },
                "then": {
                    "properties": {
                        "word": {
                            "properties": {
                                "wordTypes": {
                                    "contains": { "const": "goldenRetriever" }
                                }
                            }
                        }
                    }
                }
            },
            {
                "$comment": "Reverse: if wordTypes contains goldenRetriever, breed must be goldenRetriever",
                "if": {
                    "properties": {
                        "word": {
                            "properties": {
                                "wordTypes": {
                                    "contains": { "const": "goldenRetriever" }
                                }
                            }
                        }
                    }
                },
                "then": {
                    "properties": {
                        "dog": {
                            "properties": {
                                "breed": { "const": "goldenRetriever" }
                            },
                            "required": ["breed"]
                        }
                    }
                }
            },
            {
                "$comment": "Forward: if breed is irishSetter, wordTypes must contain it",
                "if": {
                    "properties": {
                        "dog": {
                            "properties": {
                                "breed": { "const": "irishSetter" }
                            },
                            "required": ["breed"]
                        }
                    }
                },
                "then": {
                    "properties": {
                        "word": {
                            "properties": {
                                "wordTypes": {
                                    "contains": { "const": "irishSetter" }
                                }
                            }
                        }
                    }
                }
            },
            {
                "$comment": "Reverse: if wordTypes contains irishSetter, breed must be irishSetter",
                "if": {
                    "properties": {
                        "word": {
                            "properties": {
                                "wordTypes": {
                                    "contains": { "const": "irishSetter" }
                                }
                            }
                        }
                    }
                },
                "then": {
                    "properties": {
                        "dog": {
                            "properties": {
                                "breed": { "const": "irishSetter" }
                            },
                            "required": ["breed"]
                        }
                    }
                }
            }
        ]
    }
}
