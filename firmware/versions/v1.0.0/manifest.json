    "changelog": [
        {
            "version": "1.0.0",
            "date": "2026-04-06",
            "changes": [
                "Add 41 nostr-kind elements covering regular, replaceable, ephemeral, and parameterized-replaceable kinds (kinds 0-39999)",
                "Add 4 nostr-kind sets grouped by replaceability (regular-kinds, replaceable-kinds, ephemeral-kinds, parameterized-replaceable-kinds)",
                "Add nostr-kind manifest.json with HAS_ELEMENT relationships from sets to elements",
                "Add nostr-kind to global manifest words set"
            ]
        },
        {
            "version": "1.0.0",
            "date": "2026-03-28",
            "changes": [
                "Migrate unique constraint from bare property to x-tapestry.unique on all concept JSON Schemas",
                "Add nostr-user concept (pubkey, npub, nprofile)",
                "Add nostr-relay concept (slug, websocketUrl, httpUrl)",
                "Restructure firmware: move elements and sets under their concept directories",
                "Add dog and dog-breed concepts with biconditional ENUMERATES → JSON Schema conditionals",
                "Add rover element as first dog element with breed ↔ wordTypes enforcement",
                "Rename firmware from v0.0.2 to v1.0.0"
            ]
        }
