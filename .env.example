# Tapestry Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Your nostr public key (hex format, not npub)
# This determines who is the owner/operator of this Tapestry instance
OWNER_PUBKEY=your_hex_pubkey_here

# Neo4j database password
# Choose a strong password — you'll need this to access Neo4j Browser
NEO4J_PASSWORD=change_me_to_something_secure

# set admin pubkey for the local relay (probably use same as above)
ADMIN_PUBKEYS=your_hex_pubkey_here

# Public hostname this instance is served from, e.g. tapestry.brainstorm.world.
# Used to render the Canonical field of /.well-known/security.txt; when unset or
# localhost the field is omitted rather than guessed (ADR 0036).
DOMAIN_NAME=localhost

# Allow search engines to index this instance. Defaults to false, which serves
# "Disallow: /" from /robots.txt. Set to true ONLY on the production deployment —
# a sandbox that opts in will compete with production in search results.
ALLOW_INDEXING=false
