# Tapestry Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Your nostr public key (hex format, not npub)
# This determines who is the owner/operator of this Tapestry instance
OWNER_PUBKEY=your_hex_pubkey_here

# Neo4j database password
# Choose a strong password — you'll need this to access Neo4j Browser
NEO4J_PASSWORD=change_me_to_something_secure

# set admin pubkey for the local relay (probably use same as above)
ADMIN_PUBKEYS=your_hex_pubkey_here

# Auto-pay bounties are off by default. Only owner/admins, or pubkeys in the
# allowlist below, can create bounties that spend from the shared phoenixd float.
AUTO_PAY_ENABLED=false
AUTO_PAY_ALLOWLIST_PUBKEYS=
AUTO_PAY_MAX_SATS=5000
AUTO_PAY_INTERVAL_MS=30000
AUTO_PAY_ZAP_RELAYS=wss://localhost:7777

# phoenixd HTTP API. Keep phoenixd bound to the internal Docker/network plane;
# do not publish it directly to the internet.
PHOENIXD_URL=http://phoenixd:9740
PHOENIXD_PASSWORD=change_me_after_first_phoenixd_boot

# Required before storing auto-pay delegate nsecs.
RELAY_KEY_MASTER_KEY=change_me_to_a_long_random_secret
