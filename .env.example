# Tapestry Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Your nostr public key (hex format, not npub)
# This determines who is the owner/operator of this Tapestry instance
OWNER_PUBKEY=your_hex_pubkey_here

# Neo4j database password
# Choose a strong password — you'll need this to access Neo4j Browser
NEO4J_PASSWORD=change_me_to_something_secure

# set admin pubkey for the local relay (probably use same as above)
ADMIN_PUBKEYS=your_hex_pubkey_here

# Auto-pay bounties are off by default. Only owner/admins, or pubkeys in the
# allowlist below, can create bounties that spend from the shared wallet float.
AUTO_PAY_ENABLED=false
AUTO_PAY_ALLOWLIST_PUBKEYS=
AUTO_PAY_MAX_SATS=5000
AUTO_PAY_INTERVAL_MS=30000
AUTO_PAY_ZAP_RELAYS=wss://localhost:7777

# moneydevkit agent-wallet (auto-pay payout wallet). Run
# `npx @moneydevkit/agent-wallet init` once to generate the wallet at
# ~/.mdk-wallet/config.json, then BACK UP THE MNEMONIC — it IS the funds.
# The daemon auto-starts on first use and listens on localhost only.
# All three vars are optional overrides of the init-generated config:
#MDK_WALLET_MNEMONIC=
#MDK_WALLET_NETWORK=mainnet
#MDK_WALLET_PORT=3456

# Required before storing auto-pay delegate nsecs.
RELAY_KEY_MASTER_KEY=change_me_to_a_long_random_secret

# ── Agent-to-agent payments (magic-carpet-agent CLI) ──
# Operator safety: prove the loop with dry-run, and never pay a claim without a
# recorded accept-judgment. Turn AGENT_DRY_RUN off only once you trust the loop.
AGENT_DRY_RUN=true
AGENT_REQUIRE_JUDGMENT=true
AGENT_JUDGE_MIN_CONFIDENCE=0.6
#AGENT_AUDIT_PATH=                       # default: <bounties-db-dir>/agent-audit.jsonl
# User agent (signs locally; runs anywhere):
MC_BASE_URL=http://localhost:7778
#MC_NSEC=                                # nsec or 64-char hex — the agent's identity
#MC_RELAYS=wss://localhost:7777          # relays for submit/negotiate/scan (defaults to AUTO_PAY_ZAP_RELAYS)
#MC_COOKIE_JAR=                          # default: ~/.magic-carpet-agent-cookies.json
# Public hostname this instance is served from, e.g. tapestry.brainstorm.world.
# Used to render the Canonical field of /.well-known/security.txt; when unset or
# localhost the field is omitted rather than guessed (ADR 0036).
DOMAIN_NAME=localhost

# Allow search engines to index this instance. Defaults to false, which serves
# "Disallow: /" from /robots.txt. Set to true ONLY on the production deployment —
# a sandbox that opts in will compete with production in search results.
ALLOW_INDEXING=false
