# Dev mode: read from the bundled mockData.js so the UI is populated
# without requiring a running Docker stack. Vite replaces this at build
# time; the production bundle never carries mock data through.
VITE_USE_MOCK_DATA=true

# Profile API base for kind-0 + people-search. Dev stays on mock, so
# this is irrelevant in dev — kept for parity with production.
VITE_PROFILE_API_BASE=https://brainstorm.world
