# Production: hit the real /api/communities endpoints. Empty responses
# render the empty UI states honestly — never silently fall back to
# mock data, which would mask data-layer breakage.
VITE_USE_MOCK_DATA=false

# Profile API base for kind-0 + people-search. Hits brainstorm.world's
# public /api/search/profiles + /api/profiles endpoints cross-origin
# from communities.brainstorm.world. If CORS bites, swap for "" to
# go same-origin (communities droplet's own /api/...) or add a thin
# /api/profile-proxy on the backend.
VITE_PROFILE_API_BASE=https://brainstorm.world
