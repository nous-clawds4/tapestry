# Magic Carpet — contributor kit config. Copy to `.env` (npm run agent loads it).
#   cp .env.example .env   then edit MC_NSEC.

# The live instance the CLI talks to over HTTPS. Leave as-is to use production.
MC_BASE_URL=https://magic-carpet.brainstorm.world

# Relays for the optional `negotiate scan` (reads the thread off the relay).
# The live relay is proxied at /relay. `discover`/`submit`/`negotiate send`
# don't need this — they go through the API.
MC_RELAYS=wss://magic-carpet.brainstorm.world/relay

# YOUR Nostr identity — nsec1... or 64-char hex. This signs your login and your
# submissions. Keep it secret; the server never sees it. REQUIRED for
# auth-login / discover --eligible / submit / negotiate send.
MC_NSEC=

# Where the login session cookie is cached (default: ~/.magic-carpet-agent-cookies.json)
#MC_COOKIE_JAR=
